@model AttendanceSystem.Business.DTOs.SemesterDto
@{
    ViewData["Title"] = "Add Semester";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Add New Semester</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Semester Name (e.g. Fall 2026)</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="EndDate" class="form-label">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="/Semesters/Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Semester</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
