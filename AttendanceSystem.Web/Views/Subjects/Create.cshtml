@model AttendanceSystem.Business.DTOs.SubjectDto
@{
    ViewData["Title"] = "Add Subject";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Add New Subject</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="SubjectCode" class="form-label">Subject Code</label>
                        <input asp-for="SubjectCode" class="form-control" required />
                        <span asp-validation-for="SubjectCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SubjectName" class="form-label">Subject Name</label>
                        <input asp-for="SubjectName" class="form-control" required />
                        <span asp-validation-for="SubjectName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Credits" class="form-label">Credits</label>
                        <input asp-for="Credits" type="number" class="form-control" required />
                        <span asp-validation-for="Credits" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="/Subjects/Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Subject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
