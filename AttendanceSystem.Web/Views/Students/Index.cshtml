@model IEnumerable<AttendanceSystem.Business.DTOs.StudentDto>
@{
    ViewData["Title"] = "Students";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">Students List</h4>
                <div>
                    <button type="button" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#importModal">
                        <i class="ti ti-file-import me-1"></i> Import from Excel
                    </button>
                    <a href="/Students/Create" class="btn btn-primary">
                        <i class="ti ti-plus me-1"></i> Add New Student
                    </a>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-striped dt-responsive nowrap w-100" id="datatable-buttons">
                    <thead>
                        <tr>
                            <th>Student Code</th>
                            <th>Full Name</th>
                            <th>Faculty</th>
                            <th>Major</th>
                            <th>Email</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StudentCode</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="~/assets/images/avatar-1.jpg" alt="" class="avatar avatar-md rounded-circle me-2" />
                                        <span>@item.FullName</span>
                                    </div>
                                </td>
                                <td>@item.Faculty</td>
                                <td>@item.Major</td>
                                <td>@item.Email</td>
                                <td>
                                    <a href="/Students/Edit/@item.Id" class="text-primary me-2"><i class="ti ti-edit fs-5"></i></a>
                                    <form action="/Students/Delete/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-danger p-0 m-0"><i class="ti ti-trash fs-5"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="Import" asp-controller="Students" method="post" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title">Import Students from Excel</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <p class="text-muted small mb-3">
                Please upload an Excel file (.xlsx) with the following exact columns from A to E:<br />
                <b>StudentCode | FullName | Email | Faculty | Major</b>
            </p>
            <div class="mb-3">
                <label for="excelFile" class="form-label">Select Excel File</label>
                <input class="form-control" type="file" id="excelFile" name="file" accept=".xlsx" required>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-success">Import</button>
        </div>
      </form>
    </div>
  </div>
</div>
