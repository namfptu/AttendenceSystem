@model IEnumerable<AttendanceSystem.Business.DTOs.LecturerDto>
@{
    ViewData["Title"] = "Lecturers";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fs-3 mb-1">Lecturers</h1>
                <p class="mb-0">Manage lecturers in the system</p>
            </div>
            <div>
                <a href="/Lecturers/Create" class="btn btn-primary"><i class="ti ti-plus"></i> Add Lecturer</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover js-paginate">
                <thead class="table-light border-light">
                    <tr>
                        <th>Lecturer Code</th>
                        <th>Full Name</th>
                        <th>Department</th>
                        <th>Email</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td><span class="fw-semibold">@item.LecturerCode</span></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.AvatarUrl))
                                    {
                                        <img src="@item.AvatarUrl" alt="Avatar" class="avatar avatar-md rounded-circle me-2" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="avatar avatar-md rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2 fw-bold" style="font-size:14px; width: 40px; height: 40px;">
                                            @(item.FullName?.Substring(0, 1).ToUpper() ?? "L")
                                        </div>
                                    }
                                    <span>@item.FullName</span>
                                </div>
                            </td>
                            <td>@item.Department</td>
                            <td>@item.Email</td>
                            <td>
                                <a href="/Lecturers/Edit/@item.Id" class="text-primary me-2"><i class="ti ti-edit fs-5"></i></a>
                                <form action="/Lecturers/Delete/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this lecturer?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link text-danger p-0 m-0 border-0"><i class="ti ti-trash fs-5"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No lecturers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
