@model AttendanceSystem.Business.DTOs.LecturerDto
@{
    ViewData["Title"] = "Add Lecturer";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fs-3 mb-1">Add Lecturer</h1>
                <p class="mb-0">Create a new lecturer account</p>
            </div>
            <div>
                <a href="/Lecturers" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> Back to List</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8 col-md-12">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="LecturerCode" class="form-label">Lecturer Code</label>
                        <input asp-for="LecturerCode" class="form-control" required />
                        <span asp-validation-for="LecturerCode" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Department" class="form-label">Department</label>
                        <input asp-for="Department" class="form-control" required />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Lecturers" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Lecturer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
