@model IEnumerable<AttendanceSystem.Business.DTOs.ClassSubstituteDto>
@{
    ViewData["Title"] = "Substitute Assignments";
}

<div class="row">
    <div class="col-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ti ti-check me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ti ti-alert-triangle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title">Substitute Lecturer Assignments</h4>
                <a href="/ClassSubstitutes/Create" class="btn btn-primary">Add Substitute Assignment</a>
            </div>
            <div class="card-body">
                <table class="table table-striped dt-responsive nowrap w-100" id="datatable-buttons">
                    <thead>
                        <tr>
                            <th>Class Code</th>
                            <th>Subject</th>
                            <th>Primary Lecturer</th>
                            <th>Substitute Lecturer</th>
                            <th>Date</th>
                            <th>Note</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No substitute assignments found.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ClassCode</td>
                                <td>@item.SubjectCode - @item.SubjectName</td>
                                <td>@item.PrimaryLecturerName</td>
                                <td>@item.SubstituteLecturerName</td>
                                <td>@item.SubstituteDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.Note</td>
                                <td>
                                    <form action="/ClassSubstitutes/Delete/@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this substitute assignment?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="ti ti-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
