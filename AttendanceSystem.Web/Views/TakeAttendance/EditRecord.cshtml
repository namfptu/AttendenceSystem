@model AttendanceSystem.Business.DTOs.AttendanceRecordDto
@{
    ViewData["Title"] = "Edit Attendance Record";
    var sessionId = ViewBag.SessionId;
}

<div class="row mb-4">
    <div class="col-12">
        <h4><i class="ti ti-edit me-2"></i>Edit Attendance Record</h4>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="mb-3">
            <strong>Student:</strong> @Model.StudentCode - @Model.StudentName
        </div>
        @if (Model.IsManualEdited)
        {
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-1"></i>This record was manually edited on @Model.EditedAt?.ToString("dd/MM/yyyy HH:mm")
            </div>
        }

        <form asp-action="EditRecord" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="sessionId" value="@sessionId" />
            <input type="hidden" asp-for="AttendanceSessionId" />
            <input type="hidden" asp-for="StudentId" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Present">Present</option>
                        <option value="Late">Late</option>
                        <option value="Absent">Absent</option>
                        <option value="Excused">Excused</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Note (reason for editing) <span class="text-danger">*</span></label>
                <textarea asp-for="Note" class="form-control" rows="3" placeholder="Enter reason for manual edit..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-check me-1"></i>Save Changes</button>
                <a href="/TakeAttendance?sessionId=@sessionId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
