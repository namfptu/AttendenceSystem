@model IEnumerable<AttendanceSystem.Business.DTOs.AttendanceRecordDto>
@{
    ViewData["Title"] = "Take Attendance";
    var session = ViewBag.Session as AttendanceSystem.Business.DTOs.AttendanceSessionDto;
    bool isReadOnly = session?.Status == "Closed";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="mb-1"><i class="ti ti-clipboard-check me-2"></i>Take Attendance</h4>
        @if (session != null)
        {
            <p class="text-muted mb-0">
                <strong>@session.ClassName - @session.SubjectName</strong> |
                @session.SessionDate.ToString("dd/MM/yyyy") |
                @session.StartTime.ToString(@"hh\:mm") - @session.EndTime.ToString(@"hh\:mm") |
                <span class="badge @(session.Status == "Open" ? "bg-success" : session.Status == "Closed" ? "bg-secondary" : "bg-warning text-dark")">@session.Status</span>
            </p>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form asp-controller="TakeAttendance" asp-action="Submit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="attendanceSessionId" value="@session?.Id" />

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50px">#</th>
                            <th style="width:60px">Avatar</th>
                            <th>Student Code</th>
                            <th>Full Name</th>
                            <th style="width:300px" class="text-center">Status</th>
                            <th>Note</th>
                            @if (isReadOnly)
                            {
                                <th>Edit</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 0; }
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td>@(idx+1)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(record.AvatarUrl))
                                    {
                                        <img src="@record.AvatarUrl" alt="Avatar" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;font-size:14px;">
                                            @(record.StudentName?.Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                </td>
                                <td><strong>@record.StudentCode</strong></td>
                                <td>@record.StudentName</td>
                                <td class="text-center">
                                    <input type="hidden" name="records[@idx].StudentId" value="@record.StudentId" />
                                    @if (!isReadOnly)
                                    {
                                        <div class="btn-group" role="group">
                                            <input type="radio" class="btn-check" name="records[@idx].Status" value="Present" id="present_@record.StudentId" @(record.Status == "Present" ? "checked" : "") />
                                            <label class="btn btn-outline-success btn-sm" for="present_@record.StudentId"><i class="ti ti-check"></i> Present</label>

                                            <input type="radio" class="btn-check" name="records[@idx].Status" value="Late" id="late_@record.StudentId" @(record.Status == "Late" ? "checked" : "") />
                                            <label class="btn btn-outline-warning btn-sm" for="late_@record.StudentId"><i class="ti ti-clock"></i> Late</label>

                                            <input type="radio" class="btn-check" name="records[@idx].Status" value="Absent" id="absent_@record.StudentId" @(record.Status == "Absent" ? "checked" : "") />
                                            <label class="btn btn-outline-danger btn-sm" for="absent_@record.StudentId"><i class="ti ti-x"></i> Absent</label>

                                            <input type="radio" class="btn-check" name="records[@idx].Status" value="Excused" id="excused_@record.StudentId" @(record.Status == "Excused" ? "checked" : "") />
                                            <label class="btn btn-outline-info btn-sm" for="excused_@record.StudentId"><i class="ti ti-file-text"></i> Excused</label>
                                        </div>
                                    }
                                    else
                                    {
                                        var bc = record.Status == "Present" ? "bg-success" : record.Status == "Late" ? "bg-warning text-dark" : record.Status == "Absent" ? "bg-danger" : record.Status == "Excused" ? "bg-info" : "bg-secondary";
                                        <span class="badge @bc">@record.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (!isReadOnly)
                                    {
                                        <input type="text" name="records[@idx].Note" class="form-control form-control-sm" placeholder="Note..." value="@record.Note" />
                                    }
                                    else
                                    {
                                        <span class="small">@record.Note</span>
                                    }
                                </td>
                                @if (isReadOnly)
                                {
                                    <td>
                                        @if (record.Id > 0)
                                        {
                                            <a href="/TakeAttendance/EditRecord/@record.Id?sessionId=@session.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit"></i></a>
                                        }
                                    </td>
                                }
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!isReadOnly)
    {
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-lg"><i class="ti ti-check me-1"></i>Submit Attendance</button>
            <a href="/AttendanceSessions" class="btn btn-outline-secondary btn-lg">Back</a>
        </div>
    }
    else
    {
        <div class="mt-3">
            <a href="/AttendanceSessions" class="btn btn-outline-secondary">Back to Sessions</a>
            @if (session != null)
            {
                <a href="/Export/Attendance?classSubjectId=@session.ClassSubjectId" class="btn btn-success"><i class="ti ti-download me-1"></i>Export Excel</a>
            }
        </div>
    }
</form>
