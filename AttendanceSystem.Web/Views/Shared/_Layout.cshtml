<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>@ViewData["Title"] - Attendance System</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="apple-touch-icon" sizes="180x180" href="~/assets/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="~/assets/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon-16x16.png">
  
  <!-- InApp CSS -->
  <link rel="stylesheet" crossorigin href="~/assets/css/main.css">
  @await RenderSectionAsync("Styles", required: false)
</head>

<body>
  <div id="overlay" class="overlay"></div>
  
  <!-- TOPBAR -->
  <nav id="topbar" class="navbar bg-white border-bottom fixed-top topbar px-3">
    <button id="toggleBtn" class="d-none d-lg-inline-flex btn btn-light btn-icon btn-sm ">
      <i class="ti ti-layout-sidebar-left-expand"></i>
    </button>

    <!-- MOBILE -->
    <button id="mobileBtn" class="btn btn-light btn-icon btn-sm d-lg-none me-2">
      <i class="ti ti-layout-sidebar-left-expand"></i>
    </button>
    
    <div class="ms-auto">
      <ul class="list-unstyled d-flex align-items-center mb-0 gap-1">
        <!-- Dropdown -->
        <li class="ms-3 dropdown">
          <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="~/assets/images/avatar-1.jpg" alt="User Avatar" class="avatar avatar-sm rounded-circle" />
          </a>
          <div class="dropdown-menu dropdown-menu-end p-0" style="min-width: 200px;">
            <div>
              <div class="d-flex gap-3 align-items-center border-dashed border-bottom px-3 py-3">
                <img src="~/assets/images/avatar-1.jpg" alt="" class="avatar avatar-md rounded-circle" />
                <div>
                  <h4 class="mb-0 small">@User.Identity?.Name</h4>
                  <p class="mb-0 small text-muted">@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value)</p>
                </div>
              </div>
              <div class="p-3 d-flex flex-column gap-1 small lh-lg">
                <a href="/Profile" class="text-decoration-none text-dark"><span>Account Settings</span></a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                  <button type="submit" class="btn btn-link text-decoration-none text-dark p-0 m-0"><span>Sign Out</span></button>
                </form>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <!-- SIDEBAR -->
  <aside id="sidebar" class="sidebar">
    <div class="logo-area">
      <a href="/" class="d-inline-flex align-items-center text-decoration-none">
        <img src="~/assets/images/logo.svg" alt="Logo" height="28">
        <span class="logo-text ms-2 fw-bold text-dark h4 mb-0">FPT System</span>
      </a>
    </div>
    <ul class="nav flex-column mt-3">
      <li class="px-4 py-2"><small class="nav-text text-uppercase text-muted">Main</small></li>
      <li><a class="nav-link" href="/Dashboard"><i class="ti ti-home"></i><span class="nav-text">Dashboard</span></a></li>
      
      @if (User.IsInRole("Admin"))
      {
          <li class="px-4 pt-4 pb-2"><small class="nav-text text-uppercase text-muted">Management</small></li>
          <li><a class="nav-link" href="/Lecturers"><i class="ti ti-users"></i><span class="nav-text">Lecturers</span></a></li>
          <li><a class="nav-link" href="/Students"><i class="ti ti-school"></i><span class="nav-text">Students</span></a></li>
          <li><a class="nav-link" href="/Classes"><i class="ti ti-building"></i><span class="nav-text">Classes</span></a></li>
          <li><a class="nav-link" href="/Subjects"><i class="ti ti-book"></i><span class="nav-text">Subjects</span></a></li>
          <li><a class="nav-link" href="/Semesters"><i class="ti ti-calendar-event"></i><span class="nav-text">Semesters</span></a></li>
          <li><a class="nav-link" href="/ClassSubjects"><i class="ti ti-layers-intersect"></i><span class="nav-text">Course Sections</span></a></li>
      }
      
      @if (User.IsInRole("Admin") || User.IsInRole("Lecturer") || User.IsInRole("Student"))
      {
          <li class="px-4 pt-4 pb-2"><small class="nav-text text-uppercase text-muted">Attendance</small></li>
          @if (User.IsInRole("Admin"))
          {
              <li><a class="nav-link" href="/Schedules"><i class="ti ti-calendar"></i><span class="nav-text">Schedules</span></a></li>
          }
          @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
          {
              <li><a class="nav-link" href="/AttendanceSessions"><i class="ti ti-check"></i><span class="nav-text">Sessions</span></a></li>
          }
      }
    </ul>
  </aside>

  <!-- MAIN CONTENT -->
  <main id="content" class="content py-10">
    <div class="container-fluid">
      @RenderBody()
      
      <div class="row">
        <div class="col-12">
          <footer class="text-center py-3 mt-6 border-top text-secondary">
            <p class="mb-0">Copyright © 2026 FPT Attendance System.</p>
          </footer>
        </div>
      </div>
    </div>
  </main>

  <!-- InApp JS -->
  <script type="module" crossorigin src="~/assets/js/main.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
