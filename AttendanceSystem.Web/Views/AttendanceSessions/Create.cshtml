@model AttendanceSystem.Business.DTOs.AttendanceSessionDto
@{
    ViewData["Title"] = "Create Session";
    var classSubjects = ViewBag.ClassSubjects as IEnumerable<AttendanceSystem.Business.DTOs.ClassSubjectDto>;
}

<div class="row mb-4">
    <div class="col-12">
        <h4><i class="ti ti-calendar-plus me-2"></i>Create Attendance Session</h4>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Course Section <span class="text-danger">*</span></label>
                    <select asp-for="ClassSubjectId" class="form-select" id="classSubjectSelect">
                        <option value="">-- Select --</option>
                        @if (classSubjects != null)
                        {
                            @foreach (var cs in classSubjects)
                            {
                                <option value="@cs.Id">@cs.ClassCode - @cs.SubjectName (@cs.SemesterName)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Session Date <span class="text-danger">*</span></label>
                    <input type="date" asp-for="SessionDate" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-12">
                    <label class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Session 1 - Introduction" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Start Time <span class="text-danger">*</span></label>
                    <input type="time" class="form-control" name="StartTime" value="@Model.StartTime.ToString(@"hh\:mm")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Time <span class="text-danger">*</span></label>
                    <input type="time" class="form-control" name="EndTime" value="@Model.EndTime.ToString(@"hh\:mm")" />
                </div>
                <div class="col-md-6 mb-3 d-none">
                    <label asp-for="CreatedByLecturerId" class="form-label">Created By (Lecturer ID)</label>
                    <input asp-for="CreatedByLecturerId" type="number" class="form-control" />
                    <span asp-validation-for="CreatedByLecturerId" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-check me-1"></i>Create</button>
                <a href="/AttendanceSessions" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
