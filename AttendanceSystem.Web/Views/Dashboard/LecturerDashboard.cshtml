@model AttendanceSystem.Business.DTOs.LecturerDashboardDto
@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="mb-1"><i class="ti ti-chalkboard me-2"></i>Lecturer Dashboard</h4>
        <p class="text-muted">Welcome, <strong>@Model?.LecturerName</strong></p>
    </div>
</div>

<!-- Today's Classes -->
<div class="row mb-4">
    <div class="col-12">
        <h5><i class="ti ti-calendar-event me-1"></i>Today's Classes</h5>
    </div>
</div>
@if (Model?.TodayClasses != null && Model.TodayClasses.Any())
{
    <div class="row mb-4">
        @foreach (var cls in Model.TodayClasses)
        {
            string statusBadge = cls.SessionStatus switch
            {
                "Open" => "bg-success",
                "Closed" => "bg-secondary",
                _ => "bg-warning text-dark"
            };
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="mb-1">@cls.ClassName - @cls.SubjectName</h6>
                        <p class="small text-muted mb-2">
                            @cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm") | Room: @cls.Room
                        </p>
                        @if (cls.SessionId.HasValue)
                        {
                            <span class="badge @statusBadge me-2">@cls.SessionStatus</span>
                            @if (cls.SessionStatus == "Pending")
                            {
                                <form asp-controller="AttendanceSessions" asp-action="Open" asp-route-id="@cls.SessionId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="ti ti-player-play me-1"></i>Open Session
                                    </button>
                                </form>
                            }
                            else if (cls.SessionStatus == "Open")
                            {
                                <a href="/TakeAttendance?sessionId=@cls.SessionId" class="btn btn-sm btn-primary">
                                    <i class="ti ti-clipboard-check me-1"></i>Take Attendance
                                </a>
                            }
                            else if (cls.SessionStatus == "Closed")
                            {
                                <a href="/TakeAttendance?sessionId=@cls.SessionId" class="btn btn-sm btn-outline-secondary">
                                    <i class="ti ti-eye me-1"></i>View
                                </a>
                            }
                        }
                        else
                        {
                            <span class="badge bg-light text-dark me-2">No session yet</span>
                            <form asp-controller="AttendanceSessions" asp-action="CreateAndOpen" method="post" class="d-inline">
                                <input type="hidden" name="ClassSubjectId" value="@cls.ClassSubjectId" />
                                <input type="hidden" name="ScheduleId" value="@cls.ScheduleId" />
                                <input type="hidden" name="SessionDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="Title" value="Lớp học @DateTime.Now.ToString("dd/MM/yyyy")" />
                                <input type="hidden" name="StartTime" value="@cls.StartTime.ToString(@"hh\:mm\:ss")" />
                                <input type="hidden" name="EndTime" value="@cls.EndTime.ToString(@"hh\:mm\:ss")" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="ti ti-bolt me-1"></i>Open Session
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info mb-4">No classes scheduled for today.</div>
}

<!-- Class Summaries -->
<div class="row mb-3">
    <div class="col-12">
        <h5><i class="ti ti-chart-bar me-1"></i>My Classes Overview</h5>
    </div>
</div>
@if (Model?.ClassSummaries != null && Model.ClassSummaries.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Class</th>
                        <th>Subject</th>
                        <th>Students</th>
                        <th>Sessions</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cs in Model.ClassSummaries)
                    {
                        <tr>
                            <td><strong>@cs.ClassName</strong></td>
                            <td>@cs.SubjectName</td>
                            <td>@cs.TotalStudents</td>
                            <td>@cs.TotalSessions</td>
                            <td>
                                <a href="/Export/Attendance?classSubjectId=@cs.ClassSubjectId" class="btn btn-sm btn-outline-success"><i class="ti ti-download me-1"></i>Export</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
