@model AttendanceSystem.Business.DTOs.LecturerDashboardDto
@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="mb-1"><i class="ti ti-chalkboard me-2"></i>Lecturer Dashboard</h4>
        <p class="text-muted">Welcome, <strong>@Model?.LecturerName</strong></p>
    </div>
</div>

<!-- Today's Classes -->
<div class="row mb-4">
    <div class="col-12">
        <h5><i class="ti ti-calendar-event me-1"></i>Today's Classes</h5>
    </div>
</div>
@if (Model?.TodayClasses != null && Model.TodayClasses.Any())
{
    <div class="row mb-4">
        @foreach (var cls in Model.TodayClasses)
        {
            string statusBadge = cls.SessionStatus switch
            {
                "Open" => "bg-success",
                "Closed" => "bg-secondary",
                _ => "bg-warning text-dark"
            };
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="mb-1">@cls.ClassName - @cls.SubjectName</h6>
                        <p class="small text-muted mb-2">
                            @cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm") | Room: @cls.Room
                        </p>
                        @if (cls.SessionId.HasValue)
                        {
                            <span class="badge @statusBadge me-2">@cls.SessionStatus</span>
                            @if (cls.SessionStatus == "Open")
                            {
                                <a href="/TakeAttendance?sessionId=@cls.SessionId" class="btn btn-sm btn-primary">
                                    <i class="ti ti-clipboard-check me-1"></i>Take Attendance
                                </a>
                            }
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">No session yet</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info mb-4">No classes scheduled for today.</div>
}

<!-- Class Summaries -->
<div class="row mb-3">
    <div class="col-12">
        <h5><i class="ti ti-chart-bar me-1"></i>My Classes Overview</h5>
    </div>
</div>
@if (Model?.ClassSummaries != null && Model.ClassSummaries.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Class</th>
                        <th>Subject</th>
                        <th>Students</th>
                        <th>Sessions</th>
                        <th>Avg Attendance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cs in Model.ClassSummaries)
                    {
                        string rateColor = cs.AvgAttendanceRate >= 80 ? "text-success" : (cs.AvgAttendanceRate >= 60 ? "text-warning" : "text-danger");
                        <tr>
                            <td><strong>@cs.ClassName</strong></td>
                            <td>@cs.SubjectName</td>
                            <td>@cs.TotalStudents</td>
                            <td>@cs.TotalSessions</td>
                            <td><span class="@rateColor fw-bold">@cs.AvgAttendanceRate%</span></td>
                            <td>
                                <a href="/Export/Attendance?classSubjectId=@cs.ClassSubjectId" class="btn btn-sm btn-outline-success"><i class="ti ti-download me-1"></i>Export</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
