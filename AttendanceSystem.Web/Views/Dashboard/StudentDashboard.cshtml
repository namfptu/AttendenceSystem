@model AttendanceSystem.Business.DTOs.StudentDashboardDto
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="mb-1"><i class="ti ti-school me-2"></i>My Attendance Dashboard</h4>
        <p class="text-muted">Welcome, <strong>@Model?.StudentName</strong> (@Model?.StudentCode)</p>
    </div>
</div>

@if (Model?.Courses != null && Model.Courses.Any())
{
    <div class="row">
        @foreach (var course in Model.Courses)
        {
            string borderColor = course.IsBanned ? "border-danger" : (course.AbsentPercentage > 10 ? "border-warning" : "border-success");
            string progressColor = course.IsBanned ? "bg-danger" : (course.AbsentPercentage > 10 ? "bg-warning" : "bg-success");

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm border-start border-4 @borderColor h-100">
                    <div class="card-body">
                        <h6 class="card-title mb-1">@course.SubjectCode - @course.SubjectName</h6>
                        <p class="small text-muted mb-2">@course.ClassName | GV: @course.LecturerName</p>

                        @if (course.IsBanned)
                        {
                            <div class="alert alert-danger py-1 px-2 mb-2 small">
                                <i class="ti ti-alert-triangle me-1"></i><strong>CẤM THI!</strong> Vắng quá 20%
                            </div>
                        }

                        <div class="mb-2">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Absent: @course.AbsentPercentage%</span>
                                <span>@course.AbsentCount / @course.TotalSlots slots</span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar @progressColor" style="width:@course.AbsentPercentage%"></div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 small mt-1">
                            <span class="text-success"><i class="ti ti-check"></i> Present: @course.PresentCount</span>
                            <span class="text-danger"><i class="ti ti-x"></i> Absent: @course.AbsentCount</span>
                            <span class="text-secondary ms-auto"><i class="ti ti-clock"></i> Completed: @course.CompletedSessions / @course.TotalSlots</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-5">
        <i class="ti ti-mood-empty" style="font-size:48px;"></i>
        <p class="mt-2">No course data available.</p>
    </div>
}
