@model IEnumerable<AttendanceSystem.Business.DTOs.ClassSubjectDto>
@{
    ViewData["Title"] = "Course Sections";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title">Course Sections / Assignments</h4>
                <a href="/ClassSubjects/Create" class="btn btn-primary">Add New Assignment</a>
            </div>
            <div class="card-body">
                <form method="get" class="mb-4 row align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Filter by Semester</label>
                        <select name="semesterId" class="form-select" asp-items="ViewBag.Semesters" onchange="this.form.submit()">
                            <option value="">-- All Semesters --</option>
                        </select>
                    </div>
                </form>

                <table class="table table-striped dt-responsive nowrap w-100" id="datatable-buttons">
                    <thead>
                        <tr>
                            <th>Semester</th>
                            <th>Class Code</th>
                            <th>Subject</th>
                            <th>Lecturer</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SemesterName</td>
                                <td>@item.ClassCode</td>
                                <td>@item.SubjectCode - @item.SubjectName</td>
                                <td>@item.LecturerName</td>
                                <td>
                                    @if(item.Status == 0)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if(item.Status == 1)
                                    {
                                        <span class="badge bg-warning">Closed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                </td>
                                <td>
                                    <form action="/ClassSubjects/Delete/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this assignment?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-danger p-0 m-0"><i class="ti ti-trash fs-5"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
