@model IEnumerable<AttendanceSystem.Business.DTOs.ClassStudentDto>
@using System.Linq
@{
    var classObj = ViewBag.Class as AttendanceSystem.Business.DTOs.ClassDto;
    ViewData["Title"] = $"Students in Class {classObj?.ClassCode}";
    var allStudents = ViewBag.AllStudents as IEnumerable<AttendanceSystem.Business.DTOs.StudentDto> ?? new List<AttendanceSystem.Business.DTOs.StudentDto>();
    var enrolledIds = Model?.Select(m => m.StudentId).ToHashSet() ?? new HashSet<int>();
    var availableStudents = allStudents.Where(s => !enrolledIds.Contains(s.Id)).ToList();
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title">Students in @classObj?.ClassCode - @classObj?.ClassName</h4>
                <a href="/Classes/Index" class="btn btn-light">Back to Classes</a>
            </div>
            <div class="card-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                <div class="mb-4 p-3 bg-light border rounded">
                    <div class="row">
                        <!-- Add Students Checklist -->
                        <div class="col-md-6 border-end">
                            <h5 class="fs-6 mb-3">Add Students</h5>
                            <form asp-action="AddStudent" method="post">
                                <input type="hidden" name="classId" value="@classObj?.Id" />
                                
                                <div class="mb-2">
                                    <input type="text" id="studentSearchInput" class="form-control" placeholder="Search student by name or code..." />
                                </div>
                                
                                <div class="border rounded p-2 mb-3 bg-white" style="max-height: 200px; overflow-y: auto;">
                                    <div class="form-check mb-1">
                                        <input class="form-check-input" type="checkbox" id="selectAllStudents">
                                        <label class="form-check-label fw-bold" for="selectAllStudents">
                                            Select All Visible
                                        </label>
                                    </div>
                                    <hr class="my-1">
                                    <div id="studentListContainer">
                                        @if (availableStudents.Any())
                                        {
                                            foreach (var student in availableStudents)
                                            {
                                                <div class="form-check student-checkbox-item" data-search-text="@student.StudentCode.ToLower() @student.FullName.ToLower()">
                                                    <input class="form-check-input student-checkbox" type="checkbox" name="studentIds" value="@student.Id" id="student_@student.Id">
                                                    <label class="form-check-label" for="student_@student.Id">
                                                        <span class="badge bg-secondary me-1">@student.StudentCode</span> @student.FullName
                                                    </label>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted text-center py-2">No more students available to add.</div>
                                        }
                                    </div>
                                </div>
                                
                                <button type="submit" class="btn btn-primary w-100">Add Selected Students</button>
                            </form>
                        </div>

                        <!-- Import Excel -->
                        <div class="col-md-6">
                            <h5 class="fs-6 mb-3">Import from Excel</h5>
                            <form asp-action="ImportStudents" method="post" enctype="multipart/form-data" class="row align-items-end">
                                <input type="hidden" name="classId" value="@classObj?.Id" />
                                
                                <div class="col-sm-8 mb-2 mb-sm-0">
                                    <input type="file" name="file" class="form-control" accept=".xlsx" required />
                                    <small class="text-muted">Excel file with 1 column: StudentCode</small>
                                </div>
                                <div class="col-sm-4">
                                    <button type="submit" class="btn btn-success w-100"><i class="ti ti-upload"></i> Import</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <table class="table table-striped dt-responsive nowrap w-100 js-paginate">
                    <thead>
                        <tr>
                            <th>Student Code</th>
                            <th>Student Name</th>
                            <th>Enrolled At</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StudentCode</td>
                                <td>@item.StudentName</td>
                                <td>@item.EnrolledAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if(item.Status == 0)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.Status == 1)
                                    {
                                        <span class="badge bg-danger">Dropped</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Completed</span>
                                    }
                                </td>
                                <td>
                                    <form action="/Classes/RemoveStudent/@item.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this student from the class?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="classId" value="@classObj?.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="ti ti-trash"></i> Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById('studentSearchInput');
        const selectAllCheckbox = document.getElementById('selectAllStudents');
        const studentItems = document.querySelectorAll('.student-checkbox-item');
        const checkboxes = document.querySelectorAll('.student-checkbox');

        if (searchInput) {
            searchInput.addEventListener('input', function (e) {
                const searchText = e.target.value.toLowerCase().trim();
                studentItems.forEach(function (item) {
                    const text = item.getAttribute('data-search-text');
                    if (text.includes(searchText)) {
                        item.style.setProperty('display', 'block', 'important');
                    } else {
                        item.style.setProperty('display', 'none', 'important');
                        // Deselect if hidden
                        const cb = item.querySelector('.student-checkbox');
                        if (cb) cb.checked = false;
                    }
                });
            });
        }

        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function (e) {
                const isChecked = e.target.checked;
                checkboxes.forEach(function (cb) {
                    const parent = cb.closest('.student-checkbox-item');
                    if (parent && parent.style.display !== 'none') {
                        cb.checked = isChecked;
                    }
                });
            });
        }
    });
</script>
