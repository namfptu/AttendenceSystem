@model AttendanceSystem.Business.DTOs.ClassDto
@{
    ViewData["Title"] = "Edit Class";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Edit Class</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="ClassCode" class="form-label">Class Code</label>
                        <input asp-for="ClassCode" class="form-control" required />
                        <span asp-validation-for="ClassCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ClassName" class="form-label">Class Name</label>
                        <input asp-for="ClassName" class="form-control" required />
                        <span asp-validation-for="ClassName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="/Classes/Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Update Class</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
