@model IEnumerable<AttendanceSystem.Business.DTOs.ScheduleDto>
@{
    ViewData["Title"] = "Schedules";
    var classSubjects = ViewBag.ClassSubjects as IEnumerable<AttendanceSystem.Business.DTOs.ClassSubjectDto>;
    var selectedId = ViewBag.SelectedClassSubjectId as int?;
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="ti ti-calendar me-2"></i>Schedule Management</h4>
        <a href="/Schedules/Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Add Schedule</a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small text-muted">Course Section (Lớp học phần)</label>
                <select name="classSubjectId" class="form-select">
                    <option value="">-- All Course Sections --</option>
                    @if (classSubjects != null)
                    {
                        @foreach (var cs in classSubjects)
                        {
                            <option value="@cs.Id" selected="@(selectedId == cs.Id)">@cs.ClassCode - @cs.SubjectName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Class (Lớp hành chính)</label>
                <input type="text" name="className" class="form-control" placeholder="Class code/name..." value="@ViewBag.ClassName" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Subject (Môn học)</label>
                <input type="text" name="subjectName" class="form-control" placeholder="Subject name..." value="@ViewBag.SubjectName" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Lecturer (Giảng viên)</label>
                <input type="text" name="lecturerName" class="form-control" placeholder="Lecturer name..." value="@ViewBag.LecturerName" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Day of Week (Thứ)</label>
                <select name="dayOfWeek" class="form-select">
                    <option value="">-- All --</option>
                    @foreach (DayOfWeek dow in Enum.GetValues(typeof(DayOfWeek)))
                    {
                        <option value="@dow" selected="@(ViewBag.DayOfWeek == dow.ToString())">@dow</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="ti ti-filter me-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Course Section</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Lecturer</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(idx++)</td>
                            <td><strong>@item.ClassSubjectDisplay</strong></td>
                            <td><span class="badge bg-info">@item.DayOfWeek</span></td>
                            <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                            <td>@item.Room</td>
                            <td>@item.LecturerName</td>
                            <td>
                                <a href="/Schedules/Edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this schedule?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No schedules found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
